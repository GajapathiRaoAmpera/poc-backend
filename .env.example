# Copy to .env and fill in. Never commit .env.
# MongoDB Atlas: Database → Connect → Drivers. Also allow your IP under Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ampera
APP_ORIGIN=http://localhost:3000
# development | test | production. If unset, the app assumes production.
ENVIRONMENT=development
# IPs of reverse proxies allowed to set X-Forwarded-For (the Next.js server if it runs on
# another host). Leave empty when Next and the API share a host (uvicorn trusts 127.0.0.1).
TRUSTED_PROXY_IPS=

# AI agents. Groq models must support response_format json_schema (e.g. openai/gpt-oss-120b).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PLATFORM_DAILY_RUN_LIMIT=50
AGENT_TIMEOUT_S=180
