# Copy to .env and fill in. Never commit .env.
# Supabase: use the DIRECT or SESSION-POOLER connection string (port 5432),
# not the transaction pooler (6543). Replace "postgresql://" with "postgresql+asyncpg://".
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
APP_ORIGIN=http://localhost:3000
# development | test | production. If unset, the app assumes production.
ENVIRONMENT=development
# IPs of reverse proxies allowed to set X-Forwarded-For (the Next.js server if it runs on
# another host). Leave empty when Next and the API share a host (uvicorn trusts 127.0.0.1).
TRUSTED_PROXY_IPS=
