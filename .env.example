# Copy to .env and fill in. Never commit .env.
# MongoDB Atlas: Database → Connect → Drivers. Also allow your IP under Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ampera
APP_ORIGIN=http://localhost:3000
# development | test | production. If unset, the app assumes production.
ENVIRONMENT=development
# IPs of reverse proxies allowed to set X-Forwarded-For (the Next.js server if it runs on
# another host). Leave empty when Next and the API share a host (uvicorn trusts 127.0.0.1).
TRUSTED_PROXY_IPS=

# AI agents: groq | gemini | mock. Groq models must support response_format json_schema.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Free tier: 8000 tokens per minute, which also caps one request.
GROQ_MAX_INPUT_TOKENS=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PLATFORM_DAILY_RUN_LIMIT=50
AGENT_TIMEOUT_S=180
# Groq reasoning effort per stage (JSON, merged over defaults:
# orchestrator=low, requirements/budget/plan=medium, architecture/code=high). Chat turns drop one level.
# GROQ_EFFORT={"code":"medium"}
GROQ_CHAT_EFFORT_DROP=true
# Voice (Gemini Live front-end; Groq stays the agent brain). Needs GEMINI_API_KEY above.
VOICE_ENABLED=true
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
# Each agent already has its own voice; override per agent with JSON, e.g.
# GEMINI_LIVE_VOICES={"code":"Fenrir"}
VOICE_DAILY_SESSION_LIMIT=100
# Fernet key that encrypts stored repository tokens (Deploy stage). Generate one with:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_BOX_KEY=
